{
  "name": "pi-context-recall",
  "version": "0.1.1",
  "description": "Recall original current-branch messages via a local CLI, Skill and tool-free Pi context bridge",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adlternative/pi-context-recall.git"
  },
  "homepage": "https://github.com/adlternative/pi-context-recall#readme",
  "bugs": {
    "url": "https://github.com/adlternative/pi-context-recall/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "context",
    "compaction",
    "recall"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "history.ts",
    "recall.mjs",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "TESTING.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:pi": "node --test test/pi.integration.mjs",
    "test:live": "node --test test/pi.live.mjs",
    "test:scenarios": "node --test test/pi.scenarios.mjs"
  }
}
